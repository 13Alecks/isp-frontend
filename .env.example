# ---------------------------------------------------------------------------
# Firebase client config (public — exposed to the browser)
# ---------------------------------------------------------------------------
# Get these from Firebase Console → Project Settings → "General" tab →
# "Your apps" → select/add your web app (</>) → copy the firebaseConfig object.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin SDK (server-only — keep secret)
# ---------------------------------------------------------------------------
# Get these from Firebase Console → Project Settings → "Service accounts" tab →
# "Generate new private key" → download JSON. Copy the fields below from that
# JSON file. FIREBASE_PRIVATE_KEY must keep its \n escape sequences.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Backend API (existing — used by src/config/api-client.ts)
# ---------------------------------------------------------------------------
API_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=
